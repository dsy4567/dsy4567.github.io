{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"headers": [
		{
			"source": "/api/hitokoto",
			"headers": [
				{
					"key": "Access-Control-Allow-Origin",
					"value": "*"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=600, s-maxage=600"
				}
			]
		},
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Strict-Transport-Security",
					"value": "max-age=78840000; includeSubDomains; preload"
				}
			]
		},

		{
			"source": "/css/hl.min.css",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=259200, must-revalidate"
				}
			]
		},
		{
			"source": "/js/lib/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=259200, must-revalidate"
				}
			]
		},

		{
			"source": "/icon.png",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=259200, must-revalidate"
				}
			]
		},
		{
			"source": "/favicon.ico",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=259200, must-revalidate"
				}
			]
		},
		{
			"source": "/img/avatar.webp",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=259200, must-revalidate"
				}
			]
		},
		{
			"source": "/img/bg.avif",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=259200, must-revalidate"
				}
			]
		},
		{
			"source": "/img/bg.webp",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=259200, must-revalidate"
				}
			]
		},
		{
			"source": "/img/cc-by-sa-4.0.png",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=259200, must-revalidate"
				}
			]
		},
		{
			"source": "/img/svg/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=259200, must-revalidate"
				}
			]
		},

		{
			"source": "/json/icon.json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600, must-revalidate"
				}
			]
		},
		{
			"source": "/json/ncm.json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600, must-revalidate"
				}
			]
		},
		{
			"source": "/json/theme.json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600, must-revalidate"
				}
			]
		},
		{
			"source": "/css/font.css",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600, must-revalidate"
				}
			]
		},

		{
			"source": "/",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/index.html",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/blog.html",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/friends.html",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},

		{
			"source": "/js/analytics.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/js/blog.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/js/friends.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/js/global.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/js/main.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/js/ncm.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/js/home.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/js/doc-start.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/json/blog.json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/css/global-fp.css",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/css/global-nfp.css",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/img/bg.jpg",
			"destination": "/img/bg.webp",
			"permanent": true
		},
		{
			"source": "/b/:m*",
			"has": [
				{
					"type": "header",
					"key": "sec-fetch-dest",
					"value": "document"
				}
			],
			"destination": "/blog/:m/",
			"permanent": false
		},
		{
			"source": "/blog-md/:m*",
			"destination": "/blog/:m",
			"permanent": true
		}
	],
	"rewrites": [
		{
			"source": "/dns-query",
			"destination": "https://dns.google/dns-query"
		},
		{
			"source": "/dns-query-cf",
			"destination": "https://one.one.one.one/dns-query"
		},
		{
			"source": "/dns-query-cn",
			"destination": "https://doh.pub/dns-query"
		},
		{
			"source": "/google-fonts",
			"destination": "https://fonts.googleapis.com/css2"
		},
		{
			"source": "/b/:m*",
			"destination": "/api/blog-og?id=:m"
		}
	],
	"framework": null,
	"buildCommand": "",
	"installCommand": "",
	"outputDirectory": "."
}
